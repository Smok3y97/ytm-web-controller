{
    "name": "com.smok3y97.ytmusicweb",
    "version": "1.11.2.0",
    "description": "Elgato Stream Deck Plugin for YouTube Music Web with Discord RPC",
    "type": "module",
    "main": "bin/plugin.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "lint": "tsc --noEmit && eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix && prettier . --write",
        "format": "prettier . --write",
        "restart": "streamdeck restart com.smok3y97.ytmusicweb",
        "pack": "rollup -c && streamdeck pack . -o ../bin"
    },
    "prettier": "@elgato/prettier-config",
    "keywords": [
        "streamdeck-plugin",
        "elgato",
        "youtube-music",
        "streamdeck-plus"
    ],
    "author": "Smok3y97",
    "license": "MIT",
    "dependencies": {
        "@elgato/streamdeck": "^2.1.2",
        "@elgato/utils": "^0.6.0",
        "@xhayper/discord-rpc": "^1.3.4",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@elgato/cli": "^1.9.0",
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/prettier-config": "^0.3.3",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^24.13.3",
        "@types/ws": "^8.18.1",
        "eslint": "^9.26.0",
        "prettier": "^3.5.0",
        "rollup": "^4.63.0",
        "typescript": "~5.9.3"
    }
}
