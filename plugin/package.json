{
  "name": "com.smok3y97.ytmusicweb",
  "version": "1.4.0.0",
  "description": "Elgato Stream Deck Plugin for YouTube Music Web with Discord RPC",
  "type": "module",
  "main": "bin/plugin.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "pack": "rollup -c && streamdeck pack . -o ../bin"
  },
  "keywords": [
    "streamdeck-plugin",
    "elgato",
    "youtube-music",
    "streamdeck-plus"
  ],
  "author": "Smok3y97",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^1.1.0",
    "discord-rpc": "^4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.0.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/discord-rpc": "^4.0.8",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "rollup": "^4.18.0",
    "typescript": "^5.4.5"
  }
}
