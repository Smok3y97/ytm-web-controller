{
  "name": "com.smok3y97.ytmusicweb",
  "version": "1.6.1.0",
  "description": "Elgato Stream Deck Plugin for YouTube Music Web with Discord RPC",
  "type": "module",
  "main": "bin/plugin.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "pack": "rollup -c && streamdeck pack . -o ../bin"
  },
  "keywords": [
    "streamdeck-plugin",
    "elgato",
    "youtube-music",
    "streamdeck-plus"
  ],
  "author": "Smok3y97",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^2.1.1",
    "@elgato/utils": "^0.5.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.18.1",
    "rollup": "^4.62.4",
    "typescript": "~5.8.2"
  }
}
